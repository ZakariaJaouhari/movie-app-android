<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ===== HOME CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HERO BANNER (full bleed) ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carouselRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:overScrollMode="never" />

            <!-- ── TENDANCES DE LA SEMAINE ── -->
            <LinearLayout
                android:id="@+id/trendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tendances de la semaine"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/trendingRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:paddingStart="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ── RECOMMANDATIONS IA ── -->
            <LinearLayout
                android:id="@+id/homeRecommendationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- ── TOP 10 ── -->
            <LinearLayout
                android:id="@+id/top10Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Top 10 en 2026"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/topRatedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ── GENRE SECTIONS (dynamiques) ── -->
            <LinearLayout
                android:id="@+id/genreSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== SERIES CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/seriesContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero TV carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvCarouselRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:overScrollMode="never" />

            <!-- Tendances séries de la semaine -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tendances séries de la semaine"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvTrendingRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:paddingStart="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- Top 10 séries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Top 10 séries en 2026"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvTopRatedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- Recommandations IA séries -->
            <LinearLayout
                android:id="@+id/tvRecommendationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- TV Genre Sections (dynamiques) -->
            <LinearLayout
                android:id="@+id/tvGenreSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== TOUT NOUVEAU ===== -->
    <LinearLayout
        android:id="@+id/comingSoonView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingTop="60dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tout Nouveau"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/comingSoonRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ===== MA LISTE ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/myListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:paddingTop="60dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ma Liste"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_margin="16dp" />

            <TextView
                android:id="@+id/myListEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/my_list_empty"
                android:textColor="#999999"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/myListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Recommandations IA -->
            <LinearLayout
                android:id="@+id/recommendationsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recommandations pour vous"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recommendationsStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IA en cours..."
                        android:textColor="#999999"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendationsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== SEARCH RESULTS ===== -->
    <LinearLayout
        android:id="@+id/searchResultsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingTop="130dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/searchStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#999999"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ===== CINÉMA ===== -->
    <LinearLayout
        android:id="@+id/cinemaView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/black"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cinémas"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="72dp"
            android:paddingStart="16dp"
            android:paddingBottom="10dp" />

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cinemaRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:background="@color/black" />

    </LinearLayout>

    <!-- ===== PROFIL ===== -->
    <ScrollView
        android:id="@+id/profileView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:background="@color/black"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_horizontal">

            <!-- Avatar initiale -->
            <TextView
                android:id="@+id/profileAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar_circle"
                android:text="?" />

            <!-- Nom d'affichage -->
            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:text="" />

            <!-- Email -->
            <TextView
                android:id="@+id/profileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#999999"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:text="" />

            <!-- Separateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222222"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp" />

            <!-- Bouton Déconnexion -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Se déconnecter"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="#222222"
                android:layout_marginBottom="16dp" />

            <!-- Bouton Supprimer compte -->
            <Button
                android:id="@+id/btnDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Supprimer mon compte"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:backgroundTint="#E50914" />

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM NAV ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/black"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- ===== HEADER OVERLAY (déclaré en dernier = rendu par-dessus tout) ===== -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_header"
        android:paddingTop="28dp"
        android:paddingBottom="72dp"
        android:paddingHorizontal="16dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="fitStart"
            android:src="@drawable/logo" />

        <!-- Right icons -->
        <LinearLayout
            android:id="@+id/rightIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/imageLogo"
            android:layout_alignBottom="@id/imageLogo"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageSearchIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/imageMoodIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_camera_mood"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/logoutIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_lock_power_off"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Tab buttons -->
        <LinearLayout
            android:id="@+id/tabAndFilterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/imageLogo"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnFilms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Films"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_pill_selected" />

            <TextView
                android:id="@+id/btnSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Séries"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_pill" />

        </LinearLayout>

        <!-- Search Bar avec micro (visible quand activée) -->
        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tabAndFilterRow"
            android:layout_marginTop="8dp"
            android:background="@color/netflix_dark_grey"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/editTextSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Ex: film d'horreur japonais, comédie romantique..."
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="#999999" />

            <ImageView
                android:id="@+id/imageMicIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_mic"
                app:tint="#999999" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
