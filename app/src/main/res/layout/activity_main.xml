<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ===== HOME CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HERO BANNER (full bleed) ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carouselRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:overScrollMode="never" />

            <!-- ── TENDANCES DE LA SEMAINE ── -->
            <LinearLayout
                android:id="@+id/trendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tendances de la semaine"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/trendingRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:paddingStart="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ── TOP 10 ── -->
            <LinearLayout
                android:id="@+id/top10Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Top 10 en 2026"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/topRatedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ── GENRE SECTIONS (dynamiques) ── -->
            <LinearLayout
                android:id="@+id/genreSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== SERIES CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/seriesContentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero TV carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tvCarouselRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:overScrollMode="never" />

            <!-- Tendances séries de la semaine -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tendances séries de la semaine"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvTrendingRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:paddingStart="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- Top 10 séries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Top 10 séries en 2026"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tvTopRatedRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- TV Genre Sections (dynamiques) -->
            <LinearLayout
                android:id="@+id/tvGenreSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== TOUT NOUVEAU ===== -->
    <LinearLayout
        android:id="@+id/comingSoonView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingTop="60dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tout Nouveau"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/comingSoonRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ===== MA LISTE ===== -->
    <LinearLayout
        android:id="@+id/myListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ma Liste"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/myListEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_list_empty"
            android:textColor="#999999"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/myListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- ===== BOTTOM NAV ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/black"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- ===== HEADER OVERLAY (déclaré en dernier = rendu par-dessus tout) ===== -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_header"
        android:paddingTop="28dp"
        android:paddingBottom="72dp"
        android:paddingHorizontal="16dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:scaleType="fitStart"
            android:src="@drawable/logo" />

        <!-- Right icons -->
        <LinearLayout
            android:id="@+id/rightIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/imageLogo"
            android:layout_alignBottom="@id/imageLogo"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageSearchIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/logoutIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_lock_power_off"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Tab buttons -->
        <LinearLayout
            android:id="@+id/tabAndFilterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/imageLogo"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnFilms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Films"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_pill_selected" />

            <TextView
                android:id="@+id/btnSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Séries"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tab_pill" />

        </LinearLayout>

        <!-- Search Bar (visible quand activée) -->
        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tabAndFilterRow"
            android:layout_marginTop="8dp"
            android:background="@color/netflix_dark_grey"
            android:hint="Rechercher des films..."
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textColorHint="#999999"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
