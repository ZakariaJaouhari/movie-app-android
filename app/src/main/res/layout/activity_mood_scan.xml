<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Films pour ton humeur"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Container des 3 états -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── État 1 : Initial ── -->
        <LinearLayout
            android:id="@+id/stateInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸"
                android:textSize="72sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prends un selfie"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="L'IA analyse ton expression et recommande\nles films parfaits pour toi ce soir"
                android:textColor="#999999"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnTakeSelfie"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Prendre un selfie"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:backgroundTint="#E50914"
                android:paddingHorizontal="40dp"
                android:layout_marginTop="48dp" />

        </LinearLayout>

        <!-- ── État 2 : Chargement ── -->
        <LinearLayout
            android:id="@+id/stateLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:indeterminateTint="#E50914" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyse de ton humeur..."
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <!-- ── État 3 : Résultat ── -->
        <LinearLayout
            android:id="@+id/stateResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Selfie + Emoji + Humeur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/selfiePreview"
                    android:layout_width="90dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:background="#1A1A1A" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/moodEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😄"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/moodLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Message IA -->
            <TextView
                android:id="@+id/moodMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp" />

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#222222"
                android:layout_marginBottom="12dp" />

            <!-- Titre films -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Films recommandés pour toi"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp" />

            <!-- Films RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moodFilmsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <!-- Bouton réanalyser -->
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Réanalyser mon humeur"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:backgroundTint="#1A1A1A"
                android:layout_margin="16dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
